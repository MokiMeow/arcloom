# Generate real random credentials with: python scripts/configure.py
ARCLOOM_ADMIN_TOKEN=
ARCLOOM_RUNNER_SECRET=
ARCLOOM_GRAPH_PASSWORD=
ARCLOOM_GRAPH_MODE=server
ARCLOOM_GRAPH_HOST=127.0.0.1
ARCLOOM_GRAPH_PORT=6379
ARCLOOM_DATA_DIR=data
ARCLOOM_LAB_URL=http://127.0.0.1:9001
ARCLOOM_TENANT=lab-01
ARCLOOM_PROVIDER=deterministic
# Optional live model; never commit credentials.
# ARCLOOM_PROVIDER=openai
# ARCLOOM_MODEL=<a tool-capable model available in your provider account>
# ARCLOOM_MODEL_API_KEY=<your provider key>
# Set true when serving behind HTTPS; also configure exact origins/hosts.
ARCLOOM_COOKIE_SECURE=false
ARCLOOM_EXECUTION_BUDGET=20
ARCLOOM_MODEL_CALL_BUDGET=20
ARCLOOM_MAX_DEPTH=3

# Optional Cloudflare decision provider. Keep tokens server-side.
# ARCLOOM_PROVIDER=cloudflare
# ARCLOOM_MODEL=@cf/cloudflare/clef
# ARCLOOM_CLOUDFLARE_ACCOUNT_ID=YOUR_32_CHARACTER_ACCOUNT_ID
# ARCLOOM_MODEL_API_KEY=YOUR_WORKERS_AI_API_TOKEN
# ARCLOOM_CLEF_MIN_CONFIDENCE=0.70
# ARCLOOM_CLEF_MIN_MARGIN=0.15

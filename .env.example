# Generate real random credentials with: python scripts/configure.py
ARCLOOM_ADMIN_TOKEN=
ARCLOOM_RUNNER_SECRET=
ARCLOOM_GRAPH_PASSWORD=
ARCLOOM_GRAPH_MODE=server
ARCLOOM_GRAPH_HOST=127.0.0.1
ARCLOOM_GRAPH_PORT=6379
# Managed instances use an ACL username, commonly falkordb. Leave empty locally.
ARCLOOM_GRAPH_USERNAME=
ARCLOOM_GRAPH_SSL=false
ARCLOOM_DATA_DIR=data
ARCLOOM_LAB_URL=http://127.0.0.1:9001
ARCLOOM_TENANT=lab-01
ARCLOOM_PROVIDER=deterministic
# Workspace policy saves separate private provider profiles in data/private/.
# Saved profiles override these initial environment settings. Keys never go in Git.
# Optional ChatGPT subscription: sign in through Workspace policy, then save a model
# available to that account; for example gpt-5.6-luna when listed.
# ARCLOOM_PROVIDER=chatgpt
# ARCLOOM_MODEL=gpt-5.6-luna
# Do not put a ChatGPT OAuth token in ARCLOOM_MODEL_API_KEY.
# Optional live model; never commit credentials.
# ARCLOOM_PROVIDER=openai
# ARCLOOM_MODEL=<a tool-capable model available in your provider account>
# ARCLOOM_MODEL_API_KEY=<your provider key>
# Optional Google Gemini native function-calling provider.
# ARCLOOM_PROVIDER=gemini
# ARCLOOM_MODEL=gemini-3.5-flash-lite
# ARCLOOM_MODEL_API_KEY=<Google AI Studio API key>
# Set true when serving behind HTTPS; also configure exact origins/hosts.
ARCLOOM_COOKIE_SECURE=false
ARCLOOM_EXECUTION_BUDGET=20
ARCLOOM_MODEL_CALL_BUDGET=20
ARCLOOM_MAX_DEPTH=3

# Optional Cloudflare decision provider. Keep tokens server-side.
# ARCLOOM_PROVIDER=cloudflare
# ARCLOOM_MODEL=@cf/cloudflare/clef
# ARCLOOM_CLOUDFLARE_ACCOUNT_ID=YOUR_32_CHARACTER_ACCOUNT_ID
# ARCLOOM_MODEL_API_KEY=YOUR_WORKERS_AI_API_TOKEN
# ARCLOOM_CLEF_MIN_CONFIDENCE=0.70
# ARCLOOM_CLEF_MIN_MARGIN=0.15
# Optional local Wrangler renewal: a fixed Unix UTC deadline, at most four days
# ahead. Only environment-owned Cloudflare planning uses it; saved UI keys win.
# ARCLOOM_CLOUDFLARE_WRANGLER_UNTIL=<Unix UTC deadline>
